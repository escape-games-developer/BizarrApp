# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtener en: https://supabase.com → proyecto → Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Nunca commitear el archivo .env real ──────────────────────────────────────
# Agregar .env al .gitignore

# ── YouTube Data API v3 ─────────────────────────────────────────────────────
# Obtener en: console.cloud.google.com → APIs → YouTube Data API v3
# Habilitar la API y crear una API Key restringida al dominio del bar
# Si no está configurada, la app usa el catálogo local (fallback)
VITE_YOUTUBE_API_KEY=AIzaSy...

# ── Acceso de invitado ───────────────────────────────────────────────────────
# Ya no es una variable de build: se prende y apaga desde
#   Admin -> Ajustes -> General -> Modo invitado
# Requiere "Anonymous sign-ins" habilitado en Supabase
# (Authentication -> Sign In / Providers). Ver supabase/AUTH_SETUP.md.

# ── Saltear la verificacion de geolocalizacion (desarrollo) ──────────────────
# Interruptor independiente del modo invitado: abre el gate para TODOS los
# usuarios. No hace falta activarlo para probar con invitado.
VITE_SKIP_GEO=false
