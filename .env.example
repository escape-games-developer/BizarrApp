# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtener en: https://supabase.com → proyecto → Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Nunca commitear el archivo .env real ──────────────────────────────────────
# Agregar .env al .gitignore

# ── YouTube Data API v3 ─────────────────────────────────────────────────────
# Obtener en: console.cloud.google.com → APIs → YouTube Data API v3
# Habilitar la API y crear una API Key restringida al dominio del bar
# Si no está configurada, la app usa el catálogo local (fallback)
VITE_YOUTUBE_API_KEY=AIzaSy...

# ── Acceso de invitado (provisorio, solo para pruebas) ───────────────────────
# Muestra un boton "Entrar como invitado" en el login que abre una sesion
# anonima de Supabase (signInAnonymously). El invitado entra SIN registro y SIN
# verificacion de geolocalizacion, y la app le muestra un cartel fijo
# "Modo invitado - datos de prueba" mientras dure la sesion.
#
# Es un bypass real del gate de geo y de registro. Definirla SOLO en local y en
# los entornos de Preview: si queda en "true" en el entorno de produccion de
# Vercel, cualquiera entra sin estar en el bar.
#
# Requiere ademas habilitar "Anonymous sign-ins" en el proyecto de Supabase:
#   Authentication -> Sign In / Providers -> Anonymous sign-ins
# Sin eso el boton aparece pero signInAnonymously() devuelve 422.
#
# Cualquier valor distinto de "true" (incluido no definirla) lo deja apagado.
VITE_GUEST_LOGIN=false

# ── Saltear la verificacion de geolocalizacion (desarrollo) ──────────────────
# Interruptor independiente del modo invitado: abre el gate para TODOS los
# usuarios. No hace falta activarlo para probar con invitado.
VITE_SKIP_GEO=false
